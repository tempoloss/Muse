[Unit]
Description=Muse library (read-only S3 mount)
Wants=network-online.target
After=network-online.target
[Service]
Type=notify
EnvironmentFile=/etc/muse/storage.env
ExecStart=/usr/bin/rclone mount ${MUSE_LIB_REMOTE} /srv/muse/lib --config /root/.config/rclone/rclone.conf --read-only --allow-other --umask 022 --vfs-cache-mode full --vfs-cache-max-size 80G --vfs-cache-max-age 720h --cache-dir /var/cache/rclone-muse --dir-cache-time 2m --attr-timeout 1m --log-level NOTICE
ExecStop=/bin/fusermount3 -uz /srv/muse/lib
Restart=on-failure
RestartSec=10
[Install]
WantedBy=multi-user.target
