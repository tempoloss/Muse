#!/bin/sh
set -eu
data=/srv/muse/data
out=/var/backups/muse/muse-$(date +%F).tar.gz
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
sqlite3 "$data/muse.sqlite" ".backup '$tmp/muse.sqlite'"
cp -a "$data/users.json" "$data/vapid.pem" "$tmp/"
if [ -d "$data/notes" ]; then cp -a "$data/notes" "$tmp/notes"; fi
tar -C "$tmp" -czf "$out.part" .
mv -f "$out.part" "$out"
find /var/backups/muse -name 'muse-*.tar.gz' -mtime +14 -delete
