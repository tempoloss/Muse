#!/bin/sh
set -eu
sha="${1:-}"
case "$sha" in ''|*[!0-9a-f]*) echo "bad sha" >&2; exit 2 ;; esac
rel=/opt/muse/releases/$sha
rm -rf "$rel"; mkdir -p "$rel"
tar -x -C "$rel"
export UV_PYTHON_INSTALL_DIR=/opt/muse/python UV_CACHE_DIR=/var/cache/uv UV_PROJECT_ENVIRONMENT="$rel/venv"
uv sync --frozen --no-dev --package muse-server --project "$rel/src"
chmod -R a+rX "$rel" /opt/muse/python
runuser -u muse -- env MUSE_CONFIG=/etc/muse/muse.toml "$rel/venv/bin/muse" db upgrade
prev=$(readlink -f /opt/muse/current 2>/dev/null || true)
ln -sfn "$rel" /opt/muse/current.new && mv -T /opt/muse/current.new /opt/muse/current
systemctl restart muse
i=0
until [ "$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:4535/)" = "200" ]; do
  i=$((i+1))
  if [ "$i" -ge 20 ]; then
    echo "health check failed; rolling back" >&2
    if [ -n "$prev" ] && [ "$prev" != "$rel" ]; then
      ln -sfn "$prev" /opt/muse/current.new && mv -T /opt/muse/current.new /opt/muse/current
      systemctl restart muse
    fi
    exit 1
  fi
  sleep 1
done
ls -1dt /opt/muse/releases/*/ | tail -n +4 | xargs -r rm -rf
echo "release $sha live"
